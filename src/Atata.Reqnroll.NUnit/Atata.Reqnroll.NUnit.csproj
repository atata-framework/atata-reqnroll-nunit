<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net462</TargetFrameworks>
    <Version>4.0.0</Version>
    <Description>
C#/.NET library that integrates Atata with Reqnroll+NUnit.

Atata.Reqnroll.NUnit on GitHub: https://github.com/atata-framework/atata-reqnroll-nunit
Atata Framework documentation: https://atata.io/

The package targets .NET 8.0 and .NET Framework 4.6.2.
    </Description>
    <RepositoryUrl>https://github.com/atata-framework/atata-reqnroll-nunit</RepositoryUrl>
    <PackageId>Atata.Reqnroll.NUnit</PackageId>
    <PackageTags>atata automation testing test reqnroll nunit</PackageTags>
    <PackageReleaseNotes>Changelog: https://github.com/atata-framework/atata-reqnroll-nunit/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/atata-framework/atata-reqnroll-nunit</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Atata" Version="4.0.0" />
    <PackageReference Include="Atata.NUnit" Version="4.0.0" />
    <PackageReference Include="PolySharp" Version="1.16.0" PrivateAssets="all" />
    <PackageReference Include="Reqnroll.NUnit" Version="3.3.4" />
  </ItemGroup>

</Project>
